# 아임웹 앱 자격증명(개발자센터에서 발급). 서버에서만 사용한다. 커밋하지 않는다.
IMWEB_CLIENT_ID=
IMWEB_CLIENT_SECRET=
IMWEB_REDIRECT_URI=https://example.com/api/auth/callback

# 세션 쿠키 서명 키. 32바이트 이상 임의 문자열.
IMWEB_SESSION_SECRET=

# 토큰·견적·이용권 저장용 Postgres. 미설정 시 메모리 저장소로 떨어진다(로컬 전용).
DATABASE_URL=

# 앱 이용권(선택). 미설정이면 무료 플랜으로 동작하며 유료 업그레이드 버튼을 노출하지 않는다.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
BILLING_PLAN_CODE=
BILLING_PRICE_KRW=
BILLING_TRIAL_DAYS=14

# 아임웹 웹훅(연동해제/만료) 서명·키. 개발자센터 설정과 맞춘다.
IMWEB_WEBHOOK_SECRET=
